# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=1234567890:replace-with-the-token-from-botfather

# Your numeric Telegram user ID, e.g. from @userinfobot (required).
# The bot refuses to start without it and ignores everyone else.
TELEGRAM_ALLOWED_USER_ID=123456789

# Groq API key (required) and model
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Timezone (IANA name) and daily briefing time (24h HH:MM)
TIMEZONE=Asia/Dubai
BRIEFING_TIME=08:00

# Optional limits
# GOG_TIMEOUT_SECONDS=60
# LLM_TIMEOUT_SECONDS=30
# ACTION_TTL_MINUTES=15
