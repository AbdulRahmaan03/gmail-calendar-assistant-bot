# Telegram Bot Configuration
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Whitelist Security: Your numeric Telegram User ID (e.g. from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=123456789

# LLM API Configuration (Groq recommended for high-speed function calling)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Regional & Scheduling Configuration
TIMEZONE=Asia/Dubai
BRIEFING_TIME=08:00
